# Joplin Data API token — found at Tools → Options → Web Clipper in Joplin Desktop
JOPLIN_API_TOKEN=your-token-here

# Joplin API base URL — default is fine unless you changed the port
JOPLIN_BASE_URL=http://localhost:41184

# --- HTTP mode (optional; `serve --transport http`, docs/remote-access.md) -----
# SBJ_TRANSPORT=stdio
# SBJ_HOST=127.0.0.1
# SBJ_PORT=8775
# SBJ_HTTP_PATH=/mcp
# The server's public origin, e.g. the tunnel's hostname (https://host, no path).
# SBJ_PUBLIC_URL=
# Tool calls per minute per caller (0 = off).
# SBJ_RATE_LIMIT_PER_MINUTE=60
# Minutes between background index syncs (0 = off).
# SBJ_SYNC_INTERVAL_MINUTES=15

# --- Sign-in for HTTP mode (all four, or none) -------------------------------
# A GitHub OAuth App on your account; callback <SBJ_PUBLIC_URL>/auth/callback.
# SBJ_GITHUB_CLIENT_ID=
# SBJ_GITHUB_CLIENT_SECRET=
# Signs the tokens handed to Claude; 32+ characters (openssl rand -base64 32).
# SBJ_JWT_SIGNING_KEY=
# Numeric GitHub user ids allowed in (https://api.github.com/users/<login>).
# SBJ_ALLOWED_GITHUB_IDS=
# OAuth clients allowed to register; default is claude.ai's callback only.
# SBJ_OAUTH_REDIRECT_URIS=https://claude.ai/api/mcp/auth_callback

# --- Semantic search (optional; requires the `[semantic]` extra) ---------------
# Embedding backend: "fastembed" (default, light) or "sentence-transformers".
# SBJ_EMBEDDING_BACKEND=fastembed
# Model id override; empty uses the backend default (bge-small-en-v1.5 / bge-m3).
# SBJ_EMBEDDING_MODEL=
# Vector store: "sqlite-vec" (default, single file) or "chroma".
# SBJ_VECTOR_STORE=sqlite-vec
# Where the index is persisted; default is under your XDG data dir.
# SBJ_INDEX_DIR=
# Auto-sync the index before each semantic search (true/false).
# SBJ_SEMANTIC_AUTO_SYNC=true
